<h2>結果</h2>
<%= hidden_field_tag :question_id, @question.id %>

<% if @is_correct %>
  <p style="color: green;">正解！</p>
<% else %>
  <p style="color: red;">不正解…</p>
<% end %>


<h3>答え</h3>
<ul>
  <% @question.choices.where(is_correct: true).each do |c| %>
    <li><%= c.content %></li>
  <% end %>
</ul>

<h3>解説</h3>
<p><%= @question.explanation.presence || "解説はありません" %></p>

<li>
<%= link_to quiz_random_path do %>
  次の問題 <i class="fi fi-ss-right"></i>
<% end %>
</li>

<li>
<%= link_to home_index_path do %>
  <%= image_tag "rubysilver_banner_yoko.png", alt: "RubySilver Banner", class: "banner_yoko" %>
<% end %>
<li>