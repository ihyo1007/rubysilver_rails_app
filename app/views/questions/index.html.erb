<h1>問題一覧</h1>
<%= link_to "ホーム", home_index_path %>
<%= form_with url: questions_path, method: :get, local: true do |f| %>
  <%= f.label :category, "カテゴリ検索" %>

  <%= f.select :category,
               options_for_select(@categories, selected: params[:category]),
               include_blank: "すべて" %>

  <%= f.submit "検索" %>
<% end %>

<table>
  <thead>
    <tr>
      <th>#</th>
      <th>問題文</th>
    </tr>
  </thead>
  <tbody>
    <% @questions.each do |q| %>
      <div class="question-item">
        <%= link_to question_path(q), class: "question-link" do %>
          <tr>
            <td><%= q.id %></td>
            <td><%= link_to truncate(q.content, length: 50, omission: "…"), question_path(q) %></td>
          </tr>
        <% end %>
      </div>
    <% end %>
  </tbody>
</table>
