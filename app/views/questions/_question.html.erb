<div id="<%= dom_id question %>">
  <p>
    <strong>問題:</strong>
    <%= question.id %>
  </p>

  <p>
    <strong>問題文:</strong>
    <%= question.content %>
  </p>

  <p>
    <strong>正誤:</strong>
    <%= question.is_correct %>
  </p>

  <p>
    <strong>解答時刻:</strong>
    <%= question.answered_at %>
  </p>

</div>
