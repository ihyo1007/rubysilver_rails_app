<h2 class="mypage-title">マイページ</h2>

<div class="mypage-container">

  <div class="result-card">
    <%= render partial: "result_table", locals: { 
          title: "ランダム出題", 
          total_answers: @random_total_answers, 
          correct_answers: @random_correct_answers, 
          accuracy: @random_accuracy 
        } %>
  </div>

  <div class="result-card">
    <%= render partial: "result_table", locals: { 
          title: "問題一覧", 
          total_answers: @list_total_answers, 
          correct_answers: @list_correct_answers, 
          accuracy: @list_accuracy 
        } %>
  </div>

</div>

<div class="banner-wrapper">
  <%= link_to home_index_path do %>
    <%= image_tag "rubysilver_banner_yoko.png", alt: "RubySilver Banner", class: "banner_yoko" %>
  <% end %>
</div>
