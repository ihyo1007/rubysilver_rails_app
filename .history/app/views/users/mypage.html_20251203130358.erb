<h2>マイページ</h2>

<table class="result-table">
<tr>
<td><i class="fi fi-rs-pencil"></i> 解いた問題数</td>
<td class="number"><%= @list_total_answers %></td>
</tr>
<tr>
<td><i class="fi fi-rs-circle"></i> 正解した問題数</td>
<td class="number"><%= @list_correct_answers %></td>
</tr>

<div class="accuracy-wrap">
<div class="accuracy-label">
<tr>
<td><i class="fi fi-rs-medal"></i> 正答率</td>
<td class="number"><%= @lst_accuracy %>%</td>
</tr>
</div>
</table>

<!-- 正答率グラフ -->
<div class="accuracy-graph" style="--pct: <%= @accuracy %>;">
  <div class="graph-track">
    <div class="graph-fill"></div>
  </div>
</div>

<%= link_to home_index_path do %>
  <%= image_tag "rubysilver_banner_yoko.png", alt: "RubySilver Banner", class: "banner_yoko" %>
<% end %>
