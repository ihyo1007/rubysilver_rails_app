<% if @is_correct %>
    <h2 style="color: green;">正解</h2>
<% else %>
    <h2 style="color: red;">不正解</h2>
<% end %>

<h3>答え</h3>
<ul>
    <% @question.choices.where(is_correct: true).each do |choice| %>
        <li><%= choice.content %></li>
    <% end %>
</ul>
<h3>解説</h3>
<p><%= simple_format(@question.explanation) %></p>

<li>
<%= link_to questions_path, class: 'btn btn-primary' do %>
    問題一覧 <i class="fi fi-ss-left"></i>
<% end %>
</li>
<li>
<%= link_to question_path(@next_question), class: 'btn btn-success' do %>
    次の問題 <i class="fi fi-ss-right"></i>
<% end %>
</li>
