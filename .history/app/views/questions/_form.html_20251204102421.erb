<%= form_with model: @question, local: true, class: "question-form" do |f| %>
  <% if @question.errors.any? %>
    <div id="error_explanation" class="error-box">
      <h2><%= pluralize(@question.errors.count, "エラー") %> が発生しました</h2>
      <ul>
        <% @question.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :content, "問題文" %>
    <%= f.text_area :content, class: "textarea" %>
  </div>

  <div class="form-group">
    <%= f.label :category_id, "カテゴリー" %>
    <%= f.text_field :category_id, class: "input" %>
  </div>

  <div id="choices">
    <%= f.fields_for :choices do |choice_fields| %>
      <div class="choice-field card">
        <div class="choice-row">
          <%= choice_fields.label :content, "選択肢" %>
          <%= choice_fields.text_field :content, class: "input" %>
        </div>

        <div class="choice-row">
          <%= choice_fields.label :is_correct, "正解" %>
          <%= choice_fields.check_box :is_correct %>
        </div>

        <%= link_to "削除", "#", class: "remove-choice btn-red" %>
      </div>
    <% end %>
  </div>

  <%= link_to "＋ 選択肢を追加", "#", id: "add-choice", class: "btn-gray" %>

  <div class="form-group">
    <%= f.label :explanation, "解説" %>
    <%= f.text_area :explanation, class: "textarea" %>
  </div>

  <div class="actions">
    <%= f.submit "保存", class: "btn-blue" %>
  </div>
<% end %>
