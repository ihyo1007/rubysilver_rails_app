<div class="header-container">
  <%= image_tag "rubysilver_banner.png", alt: "RubySilver Banner", class: "banner" %>
</div>

<nav class="icon-nav">
  <ul>
    <li>
      <%= link_to quiz_random_path do %>
        <i class="fi fi-rr-edit"></i>
        <span>ランダム出題</span>
      <% end %>
    </li>

    <li>
      <%= link_to questions_path do %>
        <i class="fi fi-rr-edit"></i>
        <span>問題一覧</span>
      <% end %>
    </li>

    <li>
      <%= link_to mypage_path do %>
        <i class="fi fi-rs-book-alt"></i>
        <span>マイページ</span>
      <% end %>
    </li>

    <% if user_signed_in? %>
      <li>
        <%= link_to destroy_user_session_path, data: { turbo_method: :delete } do %>
          <i class="fi fi-ss-user-logout"></i>
          <span>ログアウト</span>
        <% end %>
      </li>
    <% else %>
      <li><%= link_to new_user_registration_path do %><i class="fi fi-ss-user-add"></i><span>サインアップ</span><% end %></li>
      <li><%= link_to new_user_session_path do %><i class="fi fi-ss-user"></i><span>ログイン</span><% end %></li>
    <% end %>
  </ul>
</nav>


<main class="content">
  <%= yield %>
</main>
