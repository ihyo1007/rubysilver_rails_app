            "content": "<div class=\"question-show-container\">\r\n  <h1>問題</h1>\r\n  \r\n  <div class=\"question-area\">\r\n    <p><%= simple_format(@question.content) %></p>\r\n  </div>\r\n  \r\n  <div class=\"choices-area\">\r\n    <%= form_with url: quiz_answer_path, data: { turbo: false } do %>\r\n      <% @question.choices.each do |choice| %>\r\n        <%= hidden_field_tag :question_id, @question.id %>\r\n        <div class=\"choice-box\">\r\n          <label>\r\n            <%= check_box_tag \"choice_ids[]\", choice.id %>\r\n            <%= choice.content %>\r\n          </label>\r\n        </div>\r\n      <% end %>\r\n      <div class=\"button-area\">\r\n        <%= submit_tag \"回答する\", class: \"button\" %>\r\n      </div>\r\n    <% end %>\r\n  </div>\r\n  <%= link_to \"ホーム\", home_index_path, class: \"btn btn-primary\" %>\r\n</div>"
